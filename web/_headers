# Response headers for even.appalaya.com, applied by Cloudflare's static asset server (same _headers format as
# Cloudflare Pages). See README.md.
#
# Rules apply in file order and a request collects the headers of every rule it matches; a "! Name" line removes a
# header set by an earlier rule. So /* comes first, and the /i rules replace its CSP instead of adding a second one
# (two CSP headers would both be enforced, and the site-wide one would block the invite page's inline script).
#
# Every Content-Security-Policy line but /badges/* is GENERATED from the pages by scripts/csp-hashes.mjs. Every page
# carries the same inline <script id="from-app"> (README.md, "Pages the app opens"), allowed by its hash in /*, /i,
# /i/* and /contact; the two "default-src 'none'; script-src 'sha256-…'" lines also hash i.html's own script and
# style. After any edit to a page's inline script or style, run `node web/scripts/csp-hashes.mjs` and then
# `node web/scripts/check.mjs`.
#
# The /contact policy also allows the contact form's scripts, which are files on this site, and it is the one page
# that loads anything from elsewhere, Cloudflare Turnstile (script and challenge frame).
#
# Cross-Origin-Opener-Policy: same-origin cuts the tie between these pages and any window from another site that
# opened them, or that they open: a site that opens /contact keeps no handle to move it to a fragment naming another
# group. It does not apply to frames, so Turnstile's challenge frame is unaffected, nor to plain links such as the
# tip link to Stripe. There is no Cross-Origin-Embedder-Policy: that one does apply to frames, Turnstile's included.
#
# /badges/* holds Apple's and Google's store badges, unmodified. Their SVG colours are an inline <style> and style
# attributes, which the site-wide policy blocks when an engine applies an image's own CSP (WebKit does when the file
# is opened directly), so these files get inline style and nothing else: no script, no loads.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'sha256-1X0/dHfwA5WefBZMIzXKquqs+iSMMYnoPMKVuuuxx5o='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/.well-known/apple-app-site-association
  Content-Type: application/json

/i
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'sha256-d2Xcbk00U8jKWy1D75bxOWpdRfZlRz3/Bv/nYkZkqGg=' 'sha256-1X0/dHfwA5WefBZMIzXKquqs+iSMMYnoPMKVuuuxx5o='; style-src 'sha256-L5LaSAx8jyWaoVvGHLWoErO3aRGSRlRr4qLzkAkPMsY='; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

/i/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'sha256-d2Xcbk00U8jKWy1D75bxOWpdRfZlRz3/Bv/nYkZkqGg=' 'sha256-1X0/dHfwA5WefBZMIzXKquqs+iSMMYnoPMKVuuuxx5o='; style-src 'sha256-L5LaSAx8jyWaoVvGHLWoErO3aRGSRlRr4qLzkAkPMsY='; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

/badges/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'

/contact
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-1X0/dHfwA5WefBZMIzXKquqs+iSMMYnoPMKVuuuxx5o=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
