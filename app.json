{
  "expo": {
    "name": "Even",
    "slug": "even",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "even",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.appalaya.even",
      "appleTeamId": "9S29T387N4",
      "supportsTablet": false,
      "associatedDomains": ["applinks:even.appalaya.com"],
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "processing"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appalaya.even",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "even.appalaya.com",
              "path": "/i"
            },
            {
              "scheme": "https",
              "host": "even.appalaya.com",
              "pathPrefix": "/i/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app",
          "sitemap": false
        }
      ],
      "expo-sqlite",
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-notifications",
      "expo-background-task",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Inter-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Inter-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Inter-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Inter-Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "InterDisplay",
                "fontDefinitions": [
                  { "path": "./assets/fonts/InterDisplay-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/InterDisplay-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/InterDisplay-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/InterDisplay-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E100F"
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "27.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Even uses the camera only to read invite QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
