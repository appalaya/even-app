{
  "name": "even",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm test -w @even/core",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@even/core": "*",
    "expo": "~58.0.0-preview.7",
    "expo-background-task": "~58.0.7",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~58.0.2",
    "expo-document-picker": "~58.0.1",
    "expo-file-system": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-linking": "~58.0.7",
    "expo-notifications": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.10",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.6",
    "expo-status-bar": "~58.0.1",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-reanimated": {
      "react-native": "$react-native"
    },
    "react-native-worklets": {
      "react-native": "$react-native"
    }
  }
}
