{
  "name": "even",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "dev:server": "bash scripts/dev-server.sh",
    "lint": "expo lint src web/worker",
    "typecheck": "tsc --noEmit && tsc -p web/worker",
    "test": "npm test -w @even/core && npm run test:app",
    "test:app": "vitest run",
    "eval:categories": "node scripts/eval-categories-keywords.mjs > \"${TMPDIR:-/tmp}/eval-categories.json\" && xcrun swiftc -parse-as-library -O modules/even-classifier/ios/ExpenseClassifier.swift scripts/eval-categories-strategies.swift scripts/eval-categories.swift -o \"${TMPDIR:-/tmp}/eval-categories\" && \"${TMPDIR:-/tmp}/eval-categories\" --cases \"${TMPDIR:-/tmp}/eval-categories.json\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@even/core": "*",
    "expo": "~58.0.0-preview.7",
    "expo-background-task": "~58.0.7",
    "expo-brightness": "~58.0.0",
    "expo-build-properties": "~58.0.7",
    "expo-camera": "~58.0.3",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~58.0.2",
    "expo-document-picker": "~58.0.1",
    "expo-file-system": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-linking": "~58.0.7",
    "expo-notifications": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.10",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.6",
    "expo-status-bar": "~58.0.1",
    "expo-system-ui": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.10.2",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "react-native-reanimated": {
      "react-native": "$react-native"
    },
    "react-native-worklets": {
      "react-native": "$react-native"
    }
  }
}
