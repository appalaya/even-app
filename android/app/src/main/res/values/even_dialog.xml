<?xml version="1.0" encoding="utf-8"?>
<!--
  Even: Alert.alert's dialog ("Delete this expense?", the error alerts) is still Android's AppCompat dialog, dressed
  in Even's theme: the surface colour, 28 dp corners (the sheets' radius), Inter, the title in `text`, the message in
  `textSecondary`, and sentence-case buttons in the accent. AppTheme points `alertDialogTheme` here, and
  `android:windowTitleStyle` at the title style, because React Native inflates its accessible title with the
  activity's theme rather than the dialog's.

  The colours mirror src/theme/themes.ts (light here, dark in values-night/even_dialog.xml); change them together.
  Both buttons take the accent: React Native's `style: 'destructive'` is iOS only, and a theme can colour only the
  positive button, which is also the OK of every one-button alert, so Delete is not red.

  A hand edit that prebuild keeps when run without cleaning (RELEASE-android.md).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
  <color name="even_dialog_surface">#FFFFFF</color>
  <color name="even_dialog_text">#161715</color>
  <color name="even_dialog_text_secondary">#595B56</color>
  <color name="even_dialog_accent">#1F6B5A</color>

  <style name="Even.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
    <item name="android:windowBackground">@drawable/even_dialog_background</item>
    <item name="colorAccent">@color/even_dialog_accent</item>
    <item name="android:colorAccent">@color/even_dialog_accent</item>
    <!-- The message's text appearance (TextAppearance.AppCompat.Subhead) reads its colour from here. -->
    <item name="android:textColorPrimary">@color/even_dialog_text_secondary</item>
    <item name="fontFamily">@font/even_inter</item>
    <item name="buttonBarPositiveButtonStyle">@style/Even.AlertDialog.Button</item>
    <item name="buttonBarNegativeButtonStyle">@style/Even.AlertDialog.Button</item>
    <item name="buttonBarNeutralButtonStyle">@style/Even.AlertDialog.Button</item>
  </style>

  <style name="Even.AlertDialog.Title" parent="RtlOverlay.DialogWindowTitle.AppCompat">
    <item name="android:textAppearance">@style/Even.AlertDialog.TitleText</item>
  </style>

  <style name="Even.AlertDialog.TitleText" parent="TextAppearance.AppCompat.Title">
    <item name="android:textSize">20sp</item>
    <item name="android:textColor">@color/even_dialog_text</item>
    <item name="android:fontFamily">@font/even_inter</item>
    <item name="fontFamily">@font/even_inter</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textFontWeight" tools:targetApi="28">600</item>
  </style>

  <style name="Even.AlertDialog.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
    <item name="android:textAllCaps">false</item>
    <item name="textAllCaps">false</item>
    <item name="android:textColor">@color/even_dialog_accent</item>
    <item name="android:textSize">16sp</item>
    <item name="android:letterSpacing">0</item>
    <item name="fontFamily">@font/even_inter</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textFontWeight" tools:targetApi="28">600</item>
  </style>
</resources>
