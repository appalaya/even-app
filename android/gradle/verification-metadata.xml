<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification, for one artifact: Google Tink, the native XChaCha20-Poly1305 behind
  modules/even-crypto (design.md "Crypto"). Gradle refuses to build if tink-android-1.23.0.jar's sha256 is not this
  one: Maven Central's published tink-android-1.23.0.jar.sha256, checked against the downloaded jar on
  2 October 2026. Every other artifact is trusted as before (the first trust rule matches every group except
  com.google.crypto.tink; the second is the plain `tink` some build tools use, which Maven Central publishes no
  sha256 for). To move Tink: update `strictly` in modules/even-crypto/android/build.gradle, check the new jar
  against Maven Central's .sha256, and change the component below (RELEASE-android.md).
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]google[.]crypto[.]tink$).*$" regex="true"/>
         <trust group="com.google.crypto.tink" name="tink"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.google.crypto.tink" name="tink-android" version="1.23.0">
         <artifact name="tink-android-1.23.0.jar">
            <sha256 value="c656918451b01c45ce5b20c7b6d4c388f956f61b3a3528e769048c8944c42f9e" origin="Maven Central, tink-android-1.23.0.jar.sha256"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
